meta {
  name: Gerar NFC-e offline
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/nota-fiscal/{{notaId}}/contingencia-offline
  body: json
  auth: bearer
}

headers {
  X-Fiscal-Confirmation: {{confirmation}}
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "justificativa": "Indisponibilidade comprovada da autorizadora"
  }
}
